# Copy to .env.local. Leave a key blank to skip that service.
# With no keys, Markwise runs as Aisha: embedded Postgres, no sign-in, practice marker.

# Clerk Hobby — https://dashboard.clerk.com (no card). Both keys are required together.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Free Postgres connection string. If empty, a local PGlite database is used.
DATABASE_URL=

# Gemini API free tier (AI Studio). Do not link a billing account.
# Free-tier prompts may be used to improve Google products. Markwise strips the
# account name, emails and phone numbers before a request. Do not type personal
# details into answers. New projects may need a different free model id.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback used when Gemini returns 429 or is unreachable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
