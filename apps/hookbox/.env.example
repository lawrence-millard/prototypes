# Neon connection string. @neondatabase/serverless talks to Neon's HTTPS SQL API.
# A postgres:// URL from any other host will not work.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Single dashboard user. The password is never stored; only a bcrypt hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$replace-with-output-of-npm-run-hash-password

# At least 32 characters. Used only to sign the session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Clerk dashboard login. Both keys must be set or Hookbox keeps the
# username and bcrypt login above. The publishable key is public. The secret is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated emails allowed into the dashboard when Clerk is enabled.
# Matching is case-insensitive, and the address must be verified in Clerk.
# An empty list allows nobody. Ignored when Clerk is off.
ALLOWED_EMAILS=you@example.com
